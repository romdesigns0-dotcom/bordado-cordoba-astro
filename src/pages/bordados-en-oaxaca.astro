---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import JsonLd from '../components/JsonLd.astro';
import { CONTACT_ADDRESS, WHATSAPP_LINK, WHATSAPP_LINK_WITH_MESSAGE } from '../consts';
import { SITE_CONFIG } from '../config/site';

const pageUrl = new URL('/bordados-en-oaxaca/', SITE_CONFIG.siteUrl).toString();

const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_CONFIG.siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Bordados en Oaxaca', item: pageUrl }
  ]
};

const serviceData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Bordados personalizados en Oaxaca',
  description: 'Bordado computarizado de logos, uniformes, gorras, nombres y textiles personalizados en Oaxaca de Juárez.',
  provider: {
    '@type': 'ProfessionalService',
    name: 'Uniformes y Bordados Córdoba',
    url: SITE_CONFIG.siteUrl
  },
  areaServed: {
    '@type': 'City',
    name: 'Oaxaca de Juárez'
  },
  url: pageUrl
};
---

<Layout
  title="Bordados en Oaxaca | Uniformes y Bordados Córdoba"
  description="Bordados personalizados en Oaxaca de Juárez: logos, uniformes, gorras, nombres y textiles. Envía tu diseño por WhatsApp para cotizar."
  canonical="/bordados-en-oaxaca/"
>
  <JsonLd data={breadcrumbData} />
  <JsonLd data={serviceData} />
  <Header />

  <main class="max-w-7xl mx-auto px-6 py-24 md:py-32">
    <p class="text-[10px] uppercase tracking-[0.3em] font-black text-brand-accent mb-8">Bordado computarizado</p>
    <div class="max-w-4xl">
      <h1 class="text-5xl md:text-7xl lg:text-8xl tracking-tight leading-[1.05] mb-10">
        Bordados personalizados <span class="text-brand-accent">en Oaxaca</span>
      </h1>
      <p class="text-xl md:text-2xl text-brand-secondary leading-relaxed mb-12">
        En Uniformes y Bordados Córdoba realizamos bordado computarizado para logos, uniformes, gorras, nombres y textiles personalizados en Oaxaca de Juárez.
      </p>
      <a href={WHATSAPP_LINK_WITH_MESSAGE} target="_blank" rel="noopener noreferrer" class="btn-primary inline-flex" data-track="click_quote" data-cta-location="local_seo_page">
        Cotizar por WhatsApp
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-24">
      <article class="border border-brand-border bg-brand-soft p-8">
        <h2 class="text-2xl font-display mb-4">Logos y uniformes</h2>
        <p class="text-brand-secondary leading-relaxed">Bordamos logos para uniformes de empresas, equipos, comercios y proyectos que requieren una presentación profesional.</p>
      </article>
      <article class="border border-brand-border bg-brand-soft p-8">
        <h2 class="text-2xl font-display mb-4">Gorras y textiles</h2>
        <p class="text-brand-secondary leading-relaxed">Revisamos gorras, camisas, playeras, mandiles, batas, toallas y otros textiles para confirmar la viabilidad de cada diseño.</p>
      </article>
      <article class="border border-brand-border bg-brand-soft p-8">
        <h2 class="text-2xl font-display mb-4">Diseño para bordar</h2>
        <p class="text-brand-secondary leading-relaxed">Si cuentas con una imagen o referencia, podemos revisarla y orientarte sobre el proceso de digitalización o ponchado.</p>
      </article>
    </div>

    <section class="border-t border-brand-border mt-24 pt-16 max-w-4xl">
      <h2 class="text-3xl md:text-5xl tracking-tight mb-6">¿Cómo cotizar un bordado?</h2>
      <p class="text-lg md:text-xl text-brand-secondary leading-relaxed mb-8">
        Comparte por WhatsApp tu logo o referencia, el tipo de prenda, cantidad de piezas, tamaño aproximado y ubicación del bordado. Con esos datos podemos orientarte sobre tu proyecto.
      </p>
      <p class="text-brand-secondary leading-relaxed">
        Atención en {CONTACT_ADDRESS}. Para recibir indicaciones o resolver dudas antes de visitar el taller, escríbenos por WhatsApp.
      </p>
      <a href={WHATSAPP_LINK} target="_blank" rel="noopener noreferrer" class="inline-block text-brand-accent font-bold mt-8 hover:underline" data-track="click_whatsapp" data-cta-location="local_seo_page">
        Contactar a Uniformes y Bordados Córdoba
      </a>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
